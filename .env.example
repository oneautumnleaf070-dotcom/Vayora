# =======================================================
# VAYORA – Production Environment Configuration
# =======================================================

# Frontend Firebase Client Credentials (Required)
# Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Geospatial Routing API Key (Optional for live GPS highway routing)
# Obtained from https://openrouteservice.org/dev/#/home
VITE_OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# -------------------------------------------------------
# Server-Side / Cloud Functions Secrets (Keep Secure)
# -------------------------------------------------------
# Deploy to Google Cloud Functions / Firebase Secrets:
# GEMINI_API_KEY=your_google_gemini_api_key_here
